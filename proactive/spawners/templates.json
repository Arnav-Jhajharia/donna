{
  "calendar": {
    "exam": {
      "category_keywords": ["exam", "test", "midterm", "final", "quiz", "interview"],
      "templates": [
        {
          "id": "exam_wakeup",
          "confidence": "high",
          "offset_minutes_before": 180,
          "wake_floor": true,
          "intent": "remind me {when} at {time_local}: get up, shower, breakfast"
        },
        {
          "id": "exam_prep",
          "confidence": "high",
          "offset_minutes_before": 60,
          "intent": "remind me {when} at {time_local}: {title} kicks off in one hour"
        }
      ]
    },
    "flight": {
      "category_keywords": ["flight", "boarding", "departure", "airport"],
      "templates": [
        {
          "id": "flight_prep",
          "confidence": "high",
          "offset_minutes_before": 180,
          "intent": "remind me {when} at {time_local}: pack and confirm before departure"
        },
        {
          "id": "flight_wakeup",
          "confidence": "high",
          "offset_minutes_before": 240,
          "wake_floor": true,
          "wake_only_if_before_normal": true,
          "intent": "remind me {when} at {time_local}: get up, you fly soon"
        }
      ]
    },
    "medical": {
      "category_keywords": [
        "doctor", "dentist", "physio", "physiotherapy", "surgery",
        "appointment", "clinic", "hospital", "checkup", "check-up"
