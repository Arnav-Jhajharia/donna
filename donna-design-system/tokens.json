{
  "$schema": "https://schemas.donna.app/tokens-v1.json",
  "meta": {
    "name": "Donna Design Tokens",
    "version": "1.0.0",
    "locked": true,
    "description": "Single source of truth. Never edit values without a system-wide review."
  },
  "color": {
    "core": {
      "paper":           { "value": "#FBF7F5", "role": "background",        "useOn": ["body", "app-shell"] },
      "surface":         { "value": "#F0EAE4", "role": "card-at-rest",      "useOn": ["paper"] },
      "surface-pressed": { "value": "#E7DFD7", "role": "hover-active",      "useOn": ["surface-transitions"] },
      "ink":             { "value": "#1E1A18", "role": "primary-text",      "useOn": ["paper", "surface"] },
      "rust":            { "value": "#7B5544", "role": "single-accent",     "useOn": ["one-per-screen"] },
      "muted":           { "value": "#6B615C", "role": "secondary-text",    "useOn": ["paper", "surface"] }
    },
    "scales": {
      "paper":  { "50": "#FDFAF8", "100": "#FBF7F5", "200": "#F5EFEA", "300": "#F0EAE4", "400": "#E7DFD7", "500": "#D6CAC0" },
      "ink":    { "200": "#D9CEC5", "300": "#B5A89F", "400": "#8F837C", "500": "#6B615C", "700": "#3A3331", "900": "#1E1A18" },
      "rust":   { "50": "#F5EFEA", "100": "#EBDCD2", "300": "#C9A796", "500": "#A07562", "700": "#7B5544", "900": "#4A2F23" }
    },
    "signal": {
      "success":      { "value": "#5C6B4A", "tint": "#EEF1E7", "use": "kept, noted, done" },
      "warning":      { "value": "#A8804A", "tint": "#F5EBD9", "use": "heads-up, something shifted" },
      "danger":       { "value": "#8B3A2E", "tint": "#F3E0DC", "use": "destructive confirm only" }
    }
  },
  "type": {
    "family": {
      "serif": "EB Garamond, Garamond, Georgia, serif",
      "sans":  "Red Hat Text, -apple-system, BlinkMacSystemFont, Inter, sans-serif",
      "mono":  "JetBrains Mono, SF Mono, Menlo, monospace"
    },
    "weightsAllowed": {
      "serif": [400, 500],
      "sans":  [400, 500, 600, 700],
      "notes": "Serif 700 is FORBIDDEN. Sans 700 is ONLY for tabular numerals."
    },
    "roles": {
      "display": { "family": "serif", "size": 64, "line": 65, "track": "-2.5%",  "weight": 400, "use": "marketing hero only — never in-product" },
      "h1":      { "family": "serif", "size": 44, "line": 48, "track": "-2%",    "weight": 400, "use": "page title, one per page" },
      "h2":      { "family": "serif", "size": 32, "line": 36, "track": "-1.5%",  "weight": 400, "use": "section" },
      "h3":      { "family": "serif", "size": 22, "line": 28, "track": "-1%",    "weight": 500, "use": "subsection" },
      "h4":      { "family": "sans",  "size": 15, "line": 20, "track": "0",      "weight": 600, "use": "card title — most used" },
      "lead":    { "family": "sans",  "size": 18, "line": 29, "track": "0",      "weight": 400, "use": "page/section intro, 2 sentences max" },
      "body":    { "family": "sans",  "size": 16, "line": 25, "track": "0",      "weight": 400, "use": "default voice" },
      "small":   { "family": "sans",  "size": 14, "line": 22, "track": "0",      "weight": 400, "use": "timestamps, helper" },
      "caption": { "family": "sans",  "size": 12, "line": 18, "track": "0",      "weight": 400, "use": "annotations, form hints" },
      "label":   { "family": "sans",  "size": 11, "line": 16, "track": "14%",    "weight": 500, "use": "caps section labels — always rust", "transform": "uppercase", "color": "rust" },
      "button":  { "family": "sans",  "size": 15, "line": 1,  "track": "0",      "weight": 500, "use": "action" },
      "input":   { "family": "sans",  "size": 16, "line": 25, "track": "0",      "weight": 400, "use": "placeholder & value — upright" }
    },
    "italicAllowedIn": [
      "one-word-inside-h1-or-h2",
      "proper-nouns-and-titles-in-body",
      "her-quoted-memory"
    ],
    "italicForbiddenIn": [
      "placeholder",
      "caption",
      "page-titles-whole",
      "section-labels",
      "buttons",
      "navigation",
      "card-titles",
      "chat-messages-whole"
    ]
  },
  "space": {
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16,
    "5": 24, "6": 32, "7": 48, "8": 64, "9": 96, "10": 128,
    "base": 4
  },
  "radius": {
    "none": 0, "sm": 4, "md": 8, "lg": 12, "full": 9999
  },
  "border": {
    "hairline": 1,
    "focus": 2
  },
  "elevation": {
    "none":    { "shadow": "none", "use": "default for cards" },
    "modal":   { "shadow": "0 16px 48px -12px rgba(30,26,24,0.18), 0 4px 12px -4px rgba(30,26,24,0.08)", "use": "modal dialogs only" },
    "toast":   { "shadow": "0 8px 24px -8px rgba(30,26,24,0.16)", "use": "toasts only" },
    "popover": { "shadow": "0 4px 16px -4px rgba(30,26,24,0.12)", "use": "popovers, tooltips" }
  },
  "motion": {
    "ease": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasis": "cubic-bezier(0.3, 0, 0, 1)"
    },
    "duration": { "instant": 80, "fast": 160, "base": 240, "slow": 400 }
  },
  "rules": {
    "oneRustPerScreen": true,
    "cardTreatmentsPerPage": { "max": 2, "options": ["surface-filled", "hairline"] },
    "shadowsDefault": "none",
    "shadowsAllowedOn": ["modal", "toast", "popover"],
    "minWordmarkPx": 14,
    "paletteIsClosed": true
  }
}
