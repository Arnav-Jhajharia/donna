# donna-voice — env template.
# Copy to donna-voice/.env (or set in Railway dashboard) and fill.

# ─── LiveKit Cloud ────────────────────────────────────────────────────
# Settings → Keys in cloud.livekit.io. asia-southeast region preferred
# for SG/IN traffic.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: lock the agent name (must match dispatch-rule.json).
DONNA_AGENT_NAME=donna-agent

# Outbound trunk id — printed by setup-livekit-sip.sh. Used by outbound.py.
DONNA_OUTBOUND_TRUNK_ID=

# ─── Speech providers ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Cartesia voice id. Default below = Newsman / clean conversational.
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# ─── LiteLLM proxy (Claude Sonnet 4) ──────────────────────────────────
LITELLM_BASE_URL=https://litellm.your-host/v1
LITELLM_API_KEY=
LITELLM_MODEL=claude-sonnet-4

# ─── Supabase (call logging) ──────────────────────────────────────────
# Service-role key; used server-side only. Empty values disable logging.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Twilio Elastic SIP ───────────────────────────────────────────────
# Used only by scripts/setup-livekit-sip.sh when creating the outbound
# trunk. Not read at runtime by the agent.
TWILIO_SIP_PASSWORD=
TWILIO_FROM_NUMBER=+14154232657

# ─── Brain hook (phase 2) ─────────────────────────────────────────────
# Where to fire post-call. Empty = no-op.
BRAIN_HOOK_URL=https://donna-api.your-host
VOICE_BRAIN_SECRET=

# ─── Spark reflex (Layer 3 filler) ────────────────────────────────────
# Optional. Fires when reflex regex+rhythm miss. Without this, the
# reflex layer falls back to canned fillers (mm, oh wait, etc.).
# Free tier at console.groq.com.
GROQ_API_KEY=

# ─── Misc ─────────────────────────────────────────────────────────────
HEALTH_PORT=8080
LOG_LEVEL=INFO
